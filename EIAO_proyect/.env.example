# ============================================================
# EIAO Backend — Variables de Entorno
# Copia este archivo como ".env" y rellena cada valor.
# NUNCA subas el archivo .env real a GitHub.
# ============================================================

# --- SERVIDOR ---
PORT=3000
NODE_ENV=development

# --- BASE DE DATOS (Supabase PostgreSQL) ---
# DATABASE_URL: connection pooler (pgbouncer) — la usa Prisma Client en tiempo de
# ejecución. Obtenla en Supabase > Settings > Database > Connection string > "Transaction" (puerto 6543).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: conexión directa (puerto 5432), la usa Prisma solo para `db push`/migraciones.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# SUPABASE_URL / SUPABASE_KEY: NO son leídas por el código actual (el proyecto
# se conecta a Postgres directo vía DATABASE_URL/DIRECT_URL con Prisma, no usa
# el cliente @supabase/supabase-js). Se dejan aquí solo por si en el futuro se
# agrega Supabase Storage/Auth/Realtime. Obtenlas en Supabase > Settings > API.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_KEY="tu_supabase_anon_o_service_role_key"

# --- JWT (JSON Web Tokens) ---
# Genera un string aleatorio seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="tu_secreto_jwt_super_seguro_aqui"
JWT_EXPIRES_IN="24h"

# Refresh token (para cookie httpOnly)
JWT_REFRESH_SECRET="tu_secreto_refresh_jwt_super_seguro"
JWT_REFRESH_EXPIRES_IN="7d"

# --- CORS ---
# URL de tu frontend (sin barra al final)
FRONTEND_URL="http://localhost:5500"

# --- RESEND (Servicio de correos) ---
# Obtenlo en: resend.com > API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Correo remitente verificado en Resend
EMAIL_FROM="EIAO UANL <noreply@tudominio.com>"

# --- CLOUDINARY (Almacenamiento de imágenes) ---
# Obtenlo en: cloudinary.com > Dashboard
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"
